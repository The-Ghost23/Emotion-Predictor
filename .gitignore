# ==============================================================================
# SentiPulse AI - Comprehensive .gitignore
# ==============================================================================

# Python Bytecode & Compiled Files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pythonenv/

# Distribution & Build Outputs
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Vercel Deployment & Build Cache
.vercel/

# Node & Package Managers (if frontend tooling is used)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment Variables, Secrets & Keys
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# macOS System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Jupyter Notebook Checkpoints & Data Caches
.ipynb_checkpoints/
*-checkpoint.ipynb

# Testing, Coverage & Type Check Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# IDE & Editor Configurations
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# Temporary Files & Logs
*.log
tmp/
temp/
